            {
              "name": "Set Fuel Rate",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"product_id\": \"{{productId}}\",\n  \"price_per_liter\": 295,\n  \"effective_from\": \"2026-06-05T00:00:00.000Z\"\n}" },
                "url": "{{baseUrl}}/fuel-rates"
              }
            },
