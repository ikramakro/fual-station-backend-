        {
          "name": "Sales (POS)",
          "item": [
            {
              "name": "Create Nozzle Sale (Cash)",
              "event": [{
                "listen": "test",
                "script": {
                  "exec": ["const res = pm.response.json(); if (res.data?._id) pm.collectionVariables.set('saleId', res.data._id);"],
                  "type": "text/javascript"
                }
              }],
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"sale_type\": \"nozzle\",\n  \"nozzle_id\": \"{{nozzleId}}\",\n  \"payment_method\": \"cash\",\n  \"amount_paid\": 5000,\n  \"items\": [\n    {\n      \"product_id\": \"{{productId}}\",\n      \"quantity\": 15.5,\n      \"unit_price\": 290,\n      \"subtotal\": 4495,\n      \"tank_id\": \"{{tankId}}\"\n    }\n  ]\n}" },
                "url": "{{baseUrl}}/sales"
              }
            },
            {
              "name": "Create Credit Sale",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"sale_type\": \"credit\",\n  \"customer_id\": \"{{customerId}}\",\n  \"payment_method\": \"credit\",\n  \"items\": [\n    {\n      \"product_id\": \"{{productId}}\",\n      \"quantity\": 100,\n      \"unit_price\": 270,\n      \"subtotal\": 27000,\n      \"tank_id\": \"{{tankId}}\"\n    }\n  ]\n}" },
                "url": "{{baseUrl}}/sales"
              }
            },
