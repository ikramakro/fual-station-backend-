            {
              "name": "Update Vehicle",
              "request": {
                "method": "PUT",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"vehicle_type\": \"truck\"\n}" },
                "url": "{{baseUrl}}/customers/{{customerId}}/vehicles/:vehicleId"
              }
            },
            {
              "name": "Record Customer Payment",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"amount\": 50000,\n  \"payment_method\": \"cash\",\n  \"reference_no\": \"RCP-001\"\n}" },
                "url": "{{baseUrl}}/customers/{{customerId}}/payments"
              }
            }
          ]
