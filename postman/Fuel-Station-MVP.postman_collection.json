              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"vehicle_number\": \"LEA-5678\",\n  \"vehicle_type\": \"tanker\",\n  \"fuel_type\": \"diesel\"\n}" },
                "url": "{{baseUrl}}/customers/{{customerId}}/vehicles"
