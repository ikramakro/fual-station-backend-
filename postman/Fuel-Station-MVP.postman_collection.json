            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Highway Fuel Stop\",\n  \"address\": \"M2 Motorway KM 45\",\n  \"city\": \"Sheikhupura\",\n  \"phone\": \"+92-42-9999999\",\n  \"ntn\": \"9999999-9\",\n  \"strn\": \"STRN-111111\"\n}" },
            "url": "{{baseUrl}}/stations"
          }
        },
        {
          "name": "Get Current Station",
          "request": { "method": "GET", "url": "{{baseUrl}}/stations" }
        },
        {
          "name": "Update Station",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"phone\": \"+92-42-1234567\"\n}" },
            "url": "{{baseUrl}}/stations"
          }
        },
        {
          "name": "Get Alert Settings",
          "request": { "method": "GET", "url": "{{baseUrl}}/stations/alert-settings" }
        },
        {
          "name": "Update Alert Settings",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"low_fuel_alert_threshold_pct\": 20,\n  \"alert_channels\": [\"in_app\", \"email\"]\n}" },
            "url": "{{baseUrl}}/stations/alert-settings"
          }
        },
        {
          "name": "Check Low Fuel Alerts",
          "request": { "method": "POST", "url": "{{baseUrl}}/stations/alerts/check" }
        },
        {
          "name": "List Low Fuel Alerts",
          "request": { "method": "GET", "url": "{{baseUrl}}/stations/alerts?status=active" }
        },
        {
          "name": "Resolve Low Fuel Alert",
          "request": { "method": "PUT", "url": "{{baseUrl}}/stations/alerts/:alertId/resolve" }
        }
      ]
    },
    {
      "name": "3. Purchase Module",
      "item": [
        {
          "name": "Suppliers",
          "item": [
            {
              "name": "List Suppliers",
              "request": { "method": "GET", "url": "{{baseUrl}}/suppliers" }
            },
            {
              "name": "Create Supplier",
              "event": [{
                "listen": "test",
                "script": {
                  "exec": ["const res = pm.response.json(); if (res.data?._id) pm.collectionVariables.set('supplierId', res.data._id);"],
                  "type": "text/javascript"
                }
              }],
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"name\": \"New Fuel Supplier\",\n  \"contact_person\": \"Ahmed Ali\",\n  \"phone\": \"+92-300-1234567\",\n  \"email\": \"ahmed@supplier.com\",\n  \"ntn\": \"1234567-1\",\n  \"strn\": \"STRN-123456\",\n  \"credit_limit\": 2000000,\n  \"credit_days\": 30,\n  \"opening_balance\": 0,\n  \"current_balance\": 0\n}" },
                "url": "{{baseUrl}}/suppliers"
              }
            },
            {
              "name": "Get Supplier",
              "request": { "method": "GET", "url": "{{baseUrl}}/suppliers/{{supplierId}}" }
            },
            {
              "name": "Get Supplier Balance",
              "request": { "method": "GET", "url": "{{baseUrl}}/suppliers/{{supplierId}}/balance" }
            },
            {
              "name": "Update Supplier",
              "request": {
                "method": "PUT",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"credit_limit\": 2500000\n}" },
                "url": "{{baseUrl}}/suppliers/{{supplierId}}"
              }
            }
          ]
        },
        {
          "name": "Products",
          "item": [
            {
              "name": "List Product Categories",
              "request": { "method": "GET", "url": "{{baseUrl}}/products/categories" }
            },
            {
              "name": "Create Category",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"name\": \"Additives\",\n  \"is_returnable\": true\n}" },
                "url": "{{baseUrl}}/products/categories"
              }
            },
            {
              "name": "List Products",
              "request": { "method": "GET", "url": "{{baseUrl}}/products" }
            },
            {
              "name": "Create Product (Lubricant)",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"name\": \"Fuel Injector Cleaner\",\n  \"category_id\": \"{{categoryId}}\",\n  \"unit\": \"piece\",\n  \"current_price\": 850,\n  \"is_fuel\": false\n}" },
                "url": "{{baseUrl}}/products"
              }
            }
          ]
        },
        {
          "name": "Purchase Orders",
          "item": [
            {
              "name": "List Purchase Orders",
              "request": { "method": "GET", "url": "{{baseUrl}}/purchases/orders" }
            },
            {
              "name": "Create PO (Draft)",
              "event": [{
                "listen": "test",
                "script": {
                  "exec": ["const res = pm.response.json(); if (res.data?._id) pm.collectionVariables.set('orderId', res.data._id);"],
                  "type": "text/javascript"
                }
              }],
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"supplier_id\": \"{{supplierId}}\",\n  \"status\": \"draft\",\n  \"items\": [\n    {\n      \"product_id\": \"{{productId}}\",\n      \"quantity_ordered\": 10000,\n      \"unit_price\": 250,\n      \"subtotal\": 2500000,\n      \"tank_id\": \"{{tankId}}\"\n    }\n  ],\n  \"notes\": \"Monthly diesel delivery\"\n}" },
                "url": "{{baseUrl}}/purchases/orders"
              }
            },
            {
              "name": "Create PO (Ordered)",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"supplier_id\": \"{{supplierId}}\",\n  \"status\": \"ordered\",\n  \"items\": [\n    {\n      \"product_id\": \"{{productId}}\",\n      \"quantity_ordered\": 5000,\n      \"unit_price\": 270,\n      \"subtotal\": 1350000,\n      \"tank_id\": \"{{tankId}}\"\n    }\n  ]\n}" },
                "url": "{{baseUrl}}/purchases/orders"
              }
            },
            {
              "name": "Update PO",
              "request": {
                "method": "PUT",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"status\": \"ordered\",\n  \"notes\": \"Updated order notes\"\n}" },
                "url": "{{baseUrl}}/purchases/orders/{{orderId}}"
              }
            },
            {
              "name": "Update Delivery Info",
              "request": {
                "method": "PUT",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"delivery_vehicle_no\": \"LEA-1234\",\n  \"driver_name\": \"Muhammad Khan\"\n}" },
                "url": "{{baseUrl}}/purchases/orders/{{orderId}}/delivery"
              }
            },
            {
              "name": "Receive PO",
              "request": {
                "method": "PUT",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"delivery_vehicle_no\": \"LEA-1234\",\n  \"driver_name\": \"Muhammad Khan\",\n  \"items\": [\n    {\n      \"product_id\": \"{{productId}}\",\n      \"quantity_received\": 5000\n    }\n  ]\n}" },
                "url": "{{baseUrl}}/purchases/orders/{{orderId}}/receive"
              }
            },
            {
              "name": "Cancel PO",
              "request": { "method": "PUT", "url": "{{baseUrl}}/purchases/orders/{{orderId}}/cancel" }
            },
            {
              "name": "Get PO",
              "request": { "method": "GET", "url": "{{baseUrl}}/purchases/orders/{{orderId}}" }
            }
          ]
        },
        {
          "name": "Payments & Returns",
          "item": [
            {
              "name": "List Purchase Payments",
              "request": { "method": "GET", "url": "{{baseUrl}}/purchases/payments" }
            },
            {
              "name": "Record Supplier Payment",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"supplier_id\": \"{{supplierId}}\",\n  \"amount\": 500000,\n  \"payment_method\": \"bank_transfer\",\n  \"reference_no\": \"TXN-001\",\n  \"payment_date\": \"2026-06-05\"\n}" },
                "url": "{{baseUrl}}/purchases/payments"
              }
            },
            {
              "name": "Create Purchase Return (Lubricant)",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"purchase_order_id\": \"{{orderId}}\",\n  \"supplier_id\": \"{{supplierId}}\",\n  \"reason\": \"Damaged packaging\",\n  \"items\": [\n    {\n      \"product_id\": \"{{productId}}\",\n      \"quantity\": 5,\n      \"unit_price\": 2500,\n      \"subtotal\": 12500\n    }\n  ]\n}" },
                "url": "{{baseUrl}}/purchases/returns"
              }
            },
            {
              "name": "Approve Purchase Return",
              "request": { "method": "PUT", "url": "{{baseUrl}}/purchases/returns/:returnId/approve" }
            },
            {
              "name": "Reject Purchase Return",
              "request": {
                "method": "PUT",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"rejection_reason\": \"Return window expired\"\n}" },
                "url": "{{baseUrl}}/purchases/returns/:returnId/reject"
              }
            },
            {
              "name": "List Purchase Returns",
              "request": { "method": "GET", "url": "{{baseUrl}}/purchases/returns" }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Inventory & Tanks",
      "item": [
        {
          "name": "Tanks",
          "item": [
            {
              "name": "List Tanks",
              "event": [{
                "listen": "test",
                "script": {
                  "exec": ["const res = pm.response.json(); const t = res.data?.[0] || res.data?.items?.[0]; if (t?._id) pm.collectionVariables.set('tankId', t._id);"],
                  "type": "text/javascript"
                }
              }],
              "request": { "method": "GET", "url": "{{baseUrl}}/tanks" }
            },
            {
              "name": "Create Tank",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"code\": \"T-NEW\",\n  \"name\": \"New Diesel Tank\",\n  \"fuel_type\": \"diesel\",\n  \"capacity_liters\": 60000,\n  \"current_stock_liters\": 0,\n  \"min_stock_threshold\": 6000,\n  \"is_underground\": true\n}" },
                "url": "{{baseUrl}}/tanks"
