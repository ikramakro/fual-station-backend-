                  "exec": ["const res = pm.response.json(); if (res.data?._id) pm.collectionVariables.set('shiftId', res.data._id);"],
                  "type": "text/javascript"
                }
              }],
              "request": { "method": "GET", "url": "{{baseUrl}}/shifts/current" }
