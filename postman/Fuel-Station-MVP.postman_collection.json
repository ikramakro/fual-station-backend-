              "name": "Create Lubricant Sale",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"sale_type\": \"lubricant\",\n  \"payment_method\": \"cash\",\n  \"amount_paid\": 5000,\n  \"items\": [\n    {\n      \"product_id\": \"{{productId}}\",\n      \"quantity\": 2,\n      \"unit_price\": 2500,\n      \"subtotal\": 5000\n    }\n  ]\n}" },
                "url": "{{baseUrl}}/sales"
              }
            },
            {
              "name": "Sync Offline Sales",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"sales\": [\n    {\n      \"offline_id\": \"offline-sale-001\",\n      \"sale_type\": \"nozzle\",\n      \"payment_method\": \"cash\",\n      \"amount_paid\": 3000,\n      \"created_at\": \"2026-06-05T10:30:00.000Z\",\n      \"items\": [\n        {\n          \"product_id\": \"{{productId}}\",\n          \"quantity\": 10,\n          \"unit_price\": 290,\n          \"subtotal\": 2900,\n          \"tank_id\": \"{{tankId}}\"\n        }\n      ]\n    }\n  ]\n}" },
                "url": "{{baseUrl}}/sales/sync"
              }
            },
            {
              "name": "List Sales",
              "request": { "method": "GET", "url": "{{baseUrl}}/sales?sale_type=nozzle" }
            },
            {
              "name": "Get Sale",
              "request": { "method": "GET", "url": "{{baseUrl}}/sales/{{saleId}}" }
