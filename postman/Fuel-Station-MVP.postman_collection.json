{
  "info": {
    "_postman_id": "fuel-station-mvp-api",
    "name": "Fuel Station MVP API",
    "description": "Complete API collection for Fuel Station MVP backend.\n\n## Setup\n1. Run `npm run seed` to load demo data\n2. Login as Owner → token saved automatically\n3. Use `stationId` from seed output for PIN login\n\n**Important:** Use port **5001** (not 5000). On macOS, port 5000 is used by AirPlay and returns a blank 403 error.\n\n## Demo Credentials\n- Super Admin: superadmin@cityfuel.com / SuperAdmin@123\n- Owner: admin@cityfuel.com / Admin@123\n- Manager: manager@cityfuel.com / Manager@123\n- Cashier: cashier@cityfuel.com / Cashier@123\n- Cashier PIN: 5678",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5001/api" },
    { "key": "serverUrl", "value": "http://localhost:5001" },
    { "key": "token", "value": "" },
    { "key": "stationId", "value": "" },
    { "key": "supplierId", "value": "" },
    { "key": "productId", "value": "" },
    { "key": "tankId", "value": "" },
    { "key": "nozzleId", "value": "" },
    { "key": "customerId", "value": "" },
    { "key": "orderId", "value": "" },
    { "key": "shiftId", "value": "" },
    { "key": "saleId", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "0. Auth",
      "item": [
        {
          "name": "Login (Owner)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const res = pm.response.json();",
                "if (res.data?.token) {",
                "  pm.collectionVariables.set('token', res.data.token);",
                "  if (res.data.user?.station_id) pm.collectionVariables.set('stationId', res.data.user.station_id);",
                "}"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@cityfuel.com\",\n  \"password\": \"Admin@123\"\n}" },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Login (Super Admin)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": ["const res = pm.response.json(); if (res.data?.token) pm.collectionVariables.set('token', res.data.token);"],
              "type": "text/javascript"
            }
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"superadmin@cityfuel.com\",\n  \"password\": \"SuperAdmin@123\"\n}" },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "PIN Login (Cashier)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": ["const res = pm.response.json(); if (res.data?.token) pm.collectionVariables.set('token', res.data.token);"],
              "type": "text/javascript"
            }
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"pin\": \"5678\",\n  \"station_id\": \"{{stationId}}\"\n}" },
            "url": "{{baseUrl}}/auth/pin-login"
          }
        },
        {
          "name": "Get Me",
          "request": { "method": "GET", "url": "{{baseUrl}}/auth/me" }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"currentPassword\": \"Admin@123\",\n  \"newPassword\": \"Admin@123\"\n}" },
            "url": "{{baseUrl}}/auth/change-password"
          }
        },
        {
          "name": "Logout",
          "request": { "method": "POST", "url": "{{baseUrl}}/auth/logout" }
        }
      ]
    },
    {
      "name": "1. Roles & Permissions",
      "item": [
        {
          "name": "List All Roles & Permissions",
          "request": { "method": "GET", "url": "{{baseUrl}}/permissions/roles" }
        },
        {
          "name": "Get My Permissions",
          "request": { "method": "GET", "url": "{{baseUrl}}/permissions/me" }
        },
        {
          "name": "List Audit Logs",
          "request": { "method": "GET", "url": "{{baseUrl}}/audit-logs?page=1&limit=20" }
        },
        {
          "name": "List Users",
          "request": { "method": "GET", "url": "{{baseUrl}}/users" }
        },
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"New Cashier\",\n  \"email\": \"newcashier@cityfuel.com\",\n  \"password\": \"Cashier@123\",\n  \"pin\": \"9999\",\n  \"role\": \"cashier\",\n  \"phone\": \"+92-300-9999999\"\n}" },
            "url": "{{baseUrl}}/users"
          }
        },
        {
          "name": "Set User PIN",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"pin\": \"4321\"\n}" },
            "url": "{{baseUrl}}/users/:userId/pin"
          }
        }
      ]
    },
    {
      "name": "2. Stations (Super Admin)",
      "item": [
